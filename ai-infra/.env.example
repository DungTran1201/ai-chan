# Global Infrastructure Environment Variables
COMPOSE_PROJECT_NAME=ai-chan

# Exposed Ports
FRONTEND_PORT=3000
BACKEND_PORT=8000
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_strong_password
POSTGRES_DB=ai_chan_db
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# Monitoring
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_ADMIN_PASSWORD=admin
